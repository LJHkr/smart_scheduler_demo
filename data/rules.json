    {"id":"R-03","description":"每个班至少1名具备收银技能的员工","scope":"shift","skill":"收银","minimum":1},
    {"id":"R-04","description":"工作日每班至少4人，周末每班至少6人","scope":"shift","weekday_minimum":4,"weekend_minimum":6},
    {"id":"R-05","description":"每人每周最多40小时，即最多5个班","scope":"employee_week","maximum_hours":40,"maximum_shifts":5},
